<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analisis Sistem Login - Tugas Kuliah</title>
    
    <link rel="stylesheet" href="css-zone/style-zone.css">
    <link rel="stylesheet" href="main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <style>
        body { background: #000; color: #fff; font-family: 'Arial', sans-serif; overflow: hidden; }
        
        /* Penyesuaian agar loading & login tampil di tengah */
        .popup { 
            display: none; 
            position: fixed; 
            top: 0; left: 0; 
            width: 100%; height: 100%; 
            background: rgba(0,0,0,0.9); 
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }
        
        .loading-content { text-align: center; margin-top: 20%; }
        .login-box { 
            background: #222; 
            padding: 20px; 
            border: 1px solid #444; 
            border-radius: 10px;
            text-align: center;
            max-width: 400px;
            margin: auto;
        }
        
        .btn-login {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
        .btn-fb { background: #1877F2; color: white; }
        .btn-google { background: white; color: #555; }
    </style>
</head>
<body>

    <div id="loadingScreen" class="popup" style="display: flex;">
        <div class="loading-content">
            <i class="fa-solid fa-circle-notch fa-spin" style="font-size: 50px; color: #ffba00;"></i>
            <p style="margin-top: 20px;" id="statusText">Connecting to server...</p>
        </div>
    </div>

    <div id="loginChoice" class="popup">
        <div class="login-box">
            <h3>PILIH METODE LOGIN</h3>
            <p style="font-size: 12px; color: #aaa;">Silakan login untuk memproses verifikasi akun.</p>
            
            <button class="btn-login btn-fb">
                <i class="fa-brands fa-facebook"></i> Login dengan Facebook
            </button>
            
            <button class="btn-login btn-google">
                <img src="img/style-img/google.png" width="18" style="vertical-align: middle;"> Login dengan Google
            </button>
        </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function() {
            // Simulasi: Setelah 3 detik loading, tampilkan menu login
            setTimeout(function() {
                $('#statusText').text('Server Connected!');
                
                setTimeout(function() {
                    $('#loadingScreen').fadeOut(500, function() {
                        $('#loginChoice').css('display', 'flex').hide().fadeIn(500);
                    });
                }, 1000);
                
            }, 3000);

            // Simulasi klik (Hanya memunculkan alert, tidak mengirim data ke PHP)
            $('.btn-login').click(function() {
                alert("Simulasi: Data login akan diproses secara aman melalui protokol OAuth resmi (Teori Tugas).");
            });
        });
    </script>

</body>
</html>
